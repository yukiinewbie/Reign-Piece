-- // Helper Functions \\ --
local function GetUniqueEnemies()
    local names, list = {}, {}
    if not Lives then return list end
    for _, child in ipairs(Lives:GetChildren()) do
        if child:IsA("Model") then
            local hum = child:FindFirstChildOfClass("Humanoid")
            if hum and hum.Health > 0 then
                local dName = hum.DisplayName
                if dName and dName ~= "" and not names[dName] then
                    names[dName] = true
                    table.insert(list, dName)
                end
            end
        end
    end
    table.sort(list)
    return list
end

-- Updated Target Selector supporting Prioritized and Main Enemies
local function GetClosestTarget()
    local char = LocalPlayer.Character
    local hrp = char and char:FindFirstChild("HumanoidRootPart")
    if not hrp then return nil end

    -- 1. Check Prioritized Enemies first
    if #Config.SelectedPrioritizedEnemies > 0 then
        local closest, dist = nil, math.huge
        for _, child in ipairs(Lives:GetChildren()) do
            if child:IsA("Model") then
                local hum = child:FindFirstChildOfClass("Humanoid")
                local root = child:FindFirstChild("HumanoidRootPart") or child.PrimaryPart
                if hum and hum.Health > 0 and root then
                    local isValid = false
                    for _, selectedName in ipairs(Config.SelectedPrioritizedEnemies) do
                        if hum.DisplayName == selectedName then 
                            isValid = true
                            break 
                        end
                    end
                    if isValid then
                        local d = (hrp.Position - root.Position).Magnitude
                        if d < dist then
                            dist, closest = d, root
                        end
                    end
                end
            end
        end
        if closest then return closest end
    end

    -- 2. Fall back to Main Enemies
    if #Config.SelectedMainEnemies > 0 then
        local closest, dist = nil, math.huge
        for _, child in ipairs(Lives:GetChildren()) do
            if child:IsA("Model") then
                local hum = child:FindFirstChildOfClass("Humanoid")
                local root = child:FindFirstChild("HumanoidRootPart") or child.PrimaryPart
                if hum and hum.Health > 0 and root then
                    local isValid = false
                    for _, selectedName in ipairs(Config.SelectedMainEnemies) do
                        if hum.DisplayName == selectedName then 
                            isValid = true
                            break 
                        end
                    end
                    if isValid then
                        local d = (hrp.Position - root.Position).Magnitude
                        if d < dist then
                            dist, closest = d, root
                        end
                    end
                end
            end
        end
        if closest then return closest end
    end

    return nil
end

