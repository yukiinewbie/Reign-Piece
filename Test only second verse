-- State Variables
local selectedNPCInstance = nil
local dropdownOpen = false
local autoTpEnabled = false

-- Function to scan workspace.Lives
local function getNPCData()
    local npcs = {}
    if not Lives.Parent then return npcs end -- Lives might be nil if not fully loaded

    for _, child in ipairs(Lives:GetChildren()) do
        if child:IsA("Model") then
            local humanoid = child:FindFirstChildOfClass("Humanoid")
            local rootPart = child:FindFirstChild("HumanoidRootPart") or child.PrimaryPart
            if humanoid and rootPart and humanoid.Health > 0 then
                local displayName = humanoid.DisplayName
                if displayName == "" then
                    displayName = child.Name -- Fallback
                end
                table.insert(npcs, {Name = displayName, Instance = child, Root = rootPart})
            end
        end
    end
    return npcs
end

-- Update Dropdown List
local function updateDropdown()
    for _, child in ipairs(ScrollingFrame:GetChildren()) do
        if child:IsA("TextButton") then
            child:Destroy()
        end
    end
    
    local npcs = getNPCData()
    local yOffset = 0
    local buttonHeight = 30
    
    for _, npc in ipairs(npcs) do
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(1, -10, 0, buttonHeight)
        btn.Position = UDim2.new(0, 5, 0, yOffset)
        btn.BackgroundColor3 = Color3.fromRGB(50, 50, 50)
        btn.BackgroundTransparency = 0.5
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = npc.Name
        btn.TextSize = 14
        btn.Font = Enum.Font.Gotham
        btn.Parent = ScrollingFrame
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        
        btn.MouseButton1Click:Connect(function()
            selectedNPCInstance = npc
            DropdownButton.Text = "Tgt: "..npc.Name
            ScrollingFrame.Visible = false
            dropdownOpen = false
        end)
        
        yOffset = yOffset + buttonHeight + 5
    end
    
    ScrollingFrame.CanvasSize = UDim2.new(0, 0, 0, yOffset)
end

-- Teleport Logic
local function tweenToTarget(targetRoot)
    local character = LocalPlayer.Character
    if not character then return end
    local rootPart = character:FindFirstChild("HumanoidRootPart")
    local humanoid = character:FindFirstChildOfClass("Humanoid")
    if not rootPart or not humanoid then return end

    -- 1. Initial Teleport (instantly move above target)
    rootPart.CFrame = targetRoot.CFrame + Vector3.new(0, 12, 0)
    
    -- 2. Stay flying (PlatformStand disables falling physics)
    humanoid.PlatformStand = true
    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    
    -- 3. Smooth Tween to target while hovering
    local destCFrame = targetRoot.CFrame + Vector3.new(0, 7, 0)
    local tweenInfo = TweenInfo.new(0.6, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)
    local tween = TweenService:Create(rootPart, tweenInfo, {CFrame = destCFrame})
    
    tween:Play()
    tween.Completed:Wait()
    
    -- Restore normal state
    humanoid.PlatformStand = false
    rootPart.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
end

-- Toggle Auto TP
local function toggleAutoTp()
    autoTpEnabled = not autoTpEnabled
    if autoTpEnabled then
        -- Tween Toggle Circle ON
        TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {Position = UDim2.new(0.5, 2)}):Play()
        ToggleBg.BackgroundColor3 = Color3.fromRGB(255, 50, 50) -- Red when ON
    else
        -- Tween Toggle Circle OFF
        TweenService:Create(ToggleCircle, TweenInfo.new(0.2), {Position = UDim2.new(0, 2)}):Play()
        ToggleBg.BackgroundColor3 = Color3.fromRGB(80, 80, 80) -- Gray when OFF
    end
end

-- Event Connections
DropdownButton.MouseButton1Click:Connect(function()
    dropdownOpen = not dropdownOpen
    if dropdownOpen then
        updateDropdown()
    end
    ScrollingFrame.Visible = dropdownOpen
end)

TpButton.MouseButton1Click:Connect(function()
    if selectedNPCInstance and selectedNPCInstance.Instance and selectedNPCInstance.Instance.Parent then
        tweenToTarget(selectedNPCInstance.Root)
    else
        DropdownButton.Text = "Target Invalid/Defeated"
        selectedNPCInstance = nil
    end
end)

ToggleBg.MouseButton1Click:Connect(toggleAutoTp)
-- Make the circle clickable too since it covers most of the background
ToggleCircle.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        toggleAutoTp()
    end
end)

