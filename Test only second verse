-- Teleport Logic
local function TweenToTarget(targetRoot)
    local char = LocalPlayer.Character
    if not char then return end
    local root = char:FindFirstChild("HumanoidRootPart")
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not root or not hum or isTweening then return end

    isTweening = true
    hum.PlatformStand = true

    local dist = tonumber(Config.Distance) or 7
    local posMode = Config.Position or "Top"
    local targetPos = targetRoot.Position
    local finalPos
    
    if posMode == "Top" then
        finalPos = targetPos + Vector3.new(0, dist, 0)
    elseif posMode == "Bottom" then
        finalPos = targetPos + Vector3.new(0, -dist, 0)
    elseif posMode == "Behind" then
        finalPos = (targetRoot.CFrame * CFrame.new(0, 0, dist)).Position
    else
        finalPos = targetPos + Vector3.new(0, dist, 0)
    end

    local destCFrame = CFrame.lookAt(finalPos, targetPos)
    
    if (root.Position - targetPos).Magnitude > 100 then
        root.CFrame = targetRoot.CFrame + Vector3.new(0, 100, 0)
    end

    local tween = TweenService:Create(root, TweenInfo.new(0.25, Enum.EasingStyle.Linear), {CFrame = destCFrame})
    tween:Play()
    tween.Completed:Wait()

    root.AssemblyLinearVelocity = Vector3.new(0, 0, 0)
    isTweening = false
end

